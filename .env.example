# Database (PostgreSQL 14+)
DATABASE_URL=postgres://bereyl:bereyl@localhost:5432/bereyl
# Publieke basis-URL voor links in e-mails
APP_URL=http://localhost:3000
# Opslag voor PDF's, foto's en certificaten (buiten de webroot)
STORAGE_DIR=./storage
# Demo-modus: toont herkenbare voorbeeldgegevens en de demo-routeberekening
DEMO_MODE=true

# --- E-mail (SMTP). Leeg = e-mails worden alleen gelogd in Beheer → E-maillog
MAIL_FROM=Bereyl <noreply@bereyl.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Routeberekening. Leeg = 'nog vast te stellen' (of demo-indicatie bij DEMO_MODE)
# ORS_API_KEY is een openrouteservice.org-sleutel (geocoding + wegafstand)
ORS_API_KEY=

# --- Betaalprovider (Mollie). Leeg = incasso niet actief
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=

# --- Boekhouding (nog te kiezen door Bereyl)
ACCOUNTING_PROVIDER=
ACCOUNTING_API_KEY=
